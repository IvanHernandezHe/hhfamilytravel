# Copia este archivo a .env.local (local) o agrega las variables en Vercel → Settings → Environment Variables.

# Correo de cotizaciones (https://resend.com → API Keys). Remitente de un dominio verificado en Resend.
RESEND_API_KEY=
RESEND_FROM="HH Family Travel <cotizaciones@hhfamilytravel.com>"

# Google Sheets (cuenta de servicio de Google Cloud con la API de Sheets activada).
# La hoja necesita las pestañas "Cotizaciones" y "Newsletter" (encabezados en el README) y compartirse con el correo de la cuenta de servicio.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=

# Mercado Pago (Tus integraciones → Credenciales de producción, y Webhooks → clave secreta).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Analítica
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
